# Google OAuth Configuration
# Public client ID (safe to expose)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Private client secret (NEVER expose to client)
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_PROJECT_ID=your-project-id

# JWT Secret for OAuth authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Application URL
NEXTAUTH_URL=http://localhost:3000

# Paystack Configuration
# Public key (safe to expose)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
# Private secret key (NEVER expose to client)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# Note: Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control